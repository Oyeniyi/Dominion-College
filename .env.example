# Dominion College Website — Environment Configuration Example
# Copy to .env.local for local development. Never commit real secrets.

# Application environment: development | test | staging | production
NODE_ENV=development

# Base URL for canonical metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file path (or ":memory:" for isolated tests)
DATABASE_PATH=./data/dominion_college.sqlite

# Secret key used for signing HttpOnly administrator session tokens (minimum 32 characters)
SESSION_SECRET=replace-with-at-least-32-char-random-cryptographic-secret

# Initial bootstrap administrator credentials (used only by explicit seed/bootstrap script in non-production)
BOOTSTRAP_ADMIN_EMAIL=admin@dominioncollege.edu.ng
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
BOOTSTRAP_ADMIN_NAME=School Administrator

# Private media staging directory and public media output directory
MEDIA_STAGING_DIR=./data/staging-uploads
MEDIA_PUBLIC_DIR=./public/uploads

# Configured timezone for publication dates
SCHOOL_TIMEZONE=Africa/Lagos

