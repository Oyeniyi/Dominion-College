# Dominion College Website — Environment Configuration Example
# Copy to .env.local for local development. Never commit real secrets.

# Application environment: development | test | staging | production
NODE_ENV=development

# Base URL for canonical metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string (Supabase Session Pooler or Direct URL for migrations; Transaction Pooler for Vercel runtime)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional dedicated PostgreSQL connection string for running integration tests
TEST_DATABASE_URL=

# Optional SSL override: require | prefer | disable (defaults to require for remote hosts, prefer for localhost)
DATABASE_SSL_MODE=require

# Optional SQLite source path used ONLY by offline data migration/backup scripts (not used at runtime)
SQLITE_SOURCE_PATH=./data/dominion_college.sqlite

# Secret key used for signing HttpOnly administrator session tokens (minimum 32 characters)
SESSION_SECRET=replace-with-at-least-32-char-random-cryptographic-secret

# Initial bootstrap administrator credentials (used only by explicit seed/bootstrap script in non-production)
BOOTSTRAP_ADMIN_EMAIL=admin@dominioncollege.edu.ng
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
BOOTSTRAP_ADMIN_NAME=School Administrator

# Supabase Storage configuration (server-only service role key; never expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_STAGING_BUCKET=dominion-media-staging
SUPABASE_STORAGE_PUBLIC_BUCKET=dominion-media-public

# Optional local media directories used ONLY by offline media migration script (not used at runtime)
MEDIA_STAGING_DIR=./data/staging-uploads
MEDIA_PUBLIC_DIR=./public/uploads

# Configured timezone for publication dates
SCHOOL_TIMEZONE=Africa/Lagos

